# Copy to .env (git-ignored). Every value is optional.
# Engine used by the frozen research results. hpc/config.sh picks build_<os>, which may be older:
# SIM_ENGINE=/path/to/build_ubuntu22.04/sim_engine
# Checkout with the science code and private inputs, when this one has none:
# ALPHA_SCIENCE_ROOT=/path/to/checkout
# ALPHA_PORT=8765
# ALPHA_MAX_CONCURRENT=1
# ALPHA_RUN_MEMORY_LIMIT_GB=6
# ALPHA_MIN_AVAILABLE_MEMORY_GB=3
# ALPHA_RUN_TIMEOUT_S=10800
